{
  "expo": {
    "name": "PassionFruit",
    "slug": "passionfruit",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "passionfruit",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FDF7F2",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.passionfruit.app",
      "minSdkVersion": 29,
      "predictiveBackGestureEnabled": false,
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-router",
      "expo-sharing",
      "expo-notifications",
      [
        "expo-audio",
        {
          "microphonePermission": "PassionFruit uses the microphone to record your brew sessions."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FDF7F2"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
